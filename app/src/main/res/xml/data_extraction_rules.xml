<?xml version="1.0" encoding="utf-8"?>
<!-- Catch never backs up or transfers its data: the session is transient and the
     settings are not sensitive, but there is nothing to gain from exporting them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
